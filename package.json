{
  "name": "liuguang",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "lint": "eslint . --max-warnings 0 && prettier --check '代码/liuguang/**/*.{js,css,html}' 'scripts/*.{ts,mjs}' 'src/**/*.ts' 'contracts/**/*.ts' '*.json' '*.mjs'",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/*.test.ts src/server/*.test.ts",
    "check:ui": "node scripts/check-ui.ts",
    "build": "python3 代码/liuguang/build.py",
    "start": "node src/server/index.ts",
    "seed": "node src/server/seed.ts",
    "test:e2e": "pnpm build && python3 代码/liuguang/tests/check_demo.py && python3 代码/liuguang/tests/check_styleguide.py && python3 代码/liuguang/tests/check_connection.py"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "eslint": "9.39.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.6.0",
    "drizzle-orm": "0.45.4",
    "postgres": "4.1.1",
    "zod": "4.6.7"
  }
}
